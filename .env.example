# PostgreSQL connection (Neon / Supabase / RDS / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/joflo?schema=public"

# Long random string used to sign login sessions (openssl rand -hex 32)
AUTH_SECRET=""

# Google Maps Platform key (server-side). Enable: Geocoding API + Routes API.
# Leave empty in development — distances fall back to straight-line miles x 1.2.
GOOGLE_MAPS_API_KEY=""

# Image uploads (Amazon S3). Every upload goes under AWS_FOLDER, e.g. jolof/products/2026/11/<id>.webp
# Keep the real secret only in .env / your hosting provider — never commit it.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-north-1"
AWS_BUCKET="graphics-s3-bucket"
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_FOLDER="jolof"
# Optional: public base URL for uploaded files (e.g. a CloudFront domain). Defaults to the bucket URL.
AWS_URL=""

# Square card payments (Developer Console > your app > Credentials / Locations)
# Use the Sandbox values while testing, then swap all of them for Production values when going live.
SQUARE_ENVIRONMENT="sandbox"          # sandbox | production
SQUARE_ACCESS_TOKEN=""                # secret — server only, never commit
SQUARE_LOCATION_ID=""
NEXT_PUBLIC_SQUARE_APP_ID=""          # sandbox-sq0idb-... (sandbox) or sq0idp-... (production)
NEXT_PUBLIC_SQUARE_LOCATION_ID=""     # same value as SQUARE_LOCATION_ID
# Webhooks (set up after the site is live): Developer Console > Webhooks > Subscriptions
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL=""                 # exactly the URL registered in Square, e.g. https://joloftradescenter.com/api/webhooks/square

# Public site URL — used in email links (payment links, "view your order")
APP_URL="https://joloftradescenter.com"

# Outgoing email (SMTP). Hostinger: smtp.hostinger.com, port 465 (SSL), user = the full mailbox address.
# Without these, emails are logged in Admin > Emails as "Not sent" and nothing else breaks.
SMTP_HOST=""
SMTP_PORT="465"                       # 465 = SSL · 587 = STARTTLS
SMTP_USER=""                          # e.g. orders@joloftradescenter.com
SMTP_PASS=""                          # secret — never commit
MAIL_FROM="JOLOF TRADING <orders@joloftradescenter.com>"
ADMIN_NOTIFY_EMAIL=""                 # staff inbox(es) for new orders / quotes / payments, comma-separated
