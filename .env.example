# MySQL 8 connection. Laragon default: user root, no password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/joflo_dev"

# Only for the one-time copy from the old Neon database (npm run db:copy-from-neon)
NEON_DATABASE_URL=""

# Long random string used to sign login sessions (openssl rand -hex 32)
AUTH_SECRET=""

# Google Maps Platform key (server-side). Enable: Geocoding API + Routes API.
# Leave empty in development — distances fall back to straight-line miles x 1.2.
GOOGLE_MAPS_API_KEY=""

# Image uploads (Amazon S3). Every upload goes under AWS_FOLDER, e.g. jolof/products/2026/11/<id>.webp
# Keep the real secret only in .env / your hosting provider — never commit it.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-north-1"
AWS_BUCKET="graphics-s3-bucket"
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_FOLDER="jolof"
# Optional: public base URL for uploaded files (e.g. a CloudFront domain). Defaults to the bucket URL.
AWS_URL=""
